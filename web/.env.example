# Локально не нужен — Vite проксирует /api на http://127.0.0.1:3001
VITE_API_URL=

# Только Vercel (секрет, не VITE_*): HTTP-бэкенд по IP. Браузер ходит на /api через Edge-прокси.
# Укажите в Dashboard; в репозитории не коммитьте.
# BACKEND_HTTP_URL=http://127.0.0.1:3001

# Если бэкенд уже с HTTPS — можно вместо прокси задать VITE_API_URL=https://api.example.com
