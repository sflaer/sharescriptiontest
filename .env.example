# Токен от @BotFather
BOT_TOKEN=

# HTTPS-URL Mini App (после деплоя фронта на Vercel: Root Directory = web)
WEB_APP_URL=https://your-project.vercel.app

# Текст кнопки меню (внизу чата с ботом)
MENU_BUTTON_TEXT=Подписки

# SQLite. Локально: file:./dev.db
# Fly.io с томом /data: file:/data/prod.db
DATABASE_URL=file:./dev.db

# HTTP API (локально 3001). На Fly.io задаётся PORT=8080 в Dockerfile; явно в секретах не нужно.
PORT=3001
