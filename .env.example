# Токен от @BotFather
BOT_TOKEN=

# HTTPS-URL Mini App (после деплоя фронта на Vercel: Root Directory = web)
WEB_APP_URL=https://your-project.vercel.app

# Текст кнопки меню (внизу чата с ботом)
MENU_BUTTON_TEXT=Подписки

# SQLite (путь от корня проекта). Для Postgres замените на postgresql://...
DATABASE_URL=file:./dev.db

# HTTP API для Mini App (локально по умолчанию 3001; на проде — URL вашего сервера)
PORT=3001
